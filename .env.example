# Postgres connection string (Dokploy service or external provider).
# Required at build time too: cached service reads run during `next build` prerendering.
DATABASE_URL=postgres://user:password@host:5432/sor

# iron-session encryption password — at least 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string

# Public origin of the app. Baked into QR codes, so set it before `next build`.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Persistent directory for uploaded images. Mount a volume here in Dokploy.
MEDIA_DIR=./data/media

# Seeded admin account (used by `yarn db:seed`).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Optional: Facebook Graph oEmbed token for Instagram auto-fill.
# IG_OEMBED_TOKEN=
